<?xml version="1.0"?>
<ruleset name="HelpDesk">
    <description>PHP_CodeSniffer rules for the HelpDesk application.</description>
    <file>app</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>database</file>
    <file>routes</file>
    <file>tests</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <!-- Laravel/PHPUnit test methods conventionally use snake_case. -->
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
    </rule>
</ruleset>
