{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "HelpDesk support management application.",
    "keywords": [
        "laravel",
        "helpdesk",
        "support"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/fortify": "^1.37.2",
        "laravel/sanctum": "^4.2",
        "livewire/flux": "^2.13.1",
        "livewire/livewire": "^4.1",
        "spatie/laravel-permission": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "larastan/larastan": "^3.0",
        "nunomaduro/phpinsights": "^2.12",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "phpcs": "@php vendor/bin/phpcs",
        "phpcbf": "@php vendor/bin/phpcbf",
        "phpstan": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "insights": [
            "@php artisan vendor:publish --provider=\"NunoMaduro\\PhpInsights\\Application\\Adapters\\Laravel\\InsightsServiceProvider\" --force --no-interaction",
            "@php artisan insights"
        ],
        "rector": "@php vendor/bin/rector process --dry-run",
        "rector:fix": "@php vendor/bin/rector process",
        "quality": [
            "@php vendor/bin/phpcs",
            "@php vendor/bin/phpstan analyse --memory-limit=1G",
            "@php artisan vendor:publish --provider=\"NunoMaduro\\PhpInsights\\Application\\Adapters\\Laravel\\InsightsServiceProvider\" --force --no-interaction",
            "@php artisan insights",
            "@php vendor/bin/rector process --dry-run",
            "@php vendor/bin/pint --preset=psr12 --test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
