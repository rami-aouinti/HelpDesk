    {
      "id": 1,
      "type": "timeseries",
      "title": "RAM Usage by Container",
      "description": "Docker containers monitored by cAdvisor. Container IDs are matched by their current prefixes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "MiB",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{id=~\"/docker/(b6ae7fdf0f9a.*|7629e24862b8.*|b6cba87107c0.*|9a479b4a3d7d.*)\"}/1024/1024",
          "legendFormat": "{{id}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU Usage by Container",
